<Window x:Class="HeavyFeel.App.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeavyPro Terms of Service"
        Width="640" Height="720" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource BrushBg0}"
        Foreground="{StaticResource BrushText}"
        UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
            <Image Source="{StaticResource RotaidemLogo}" Width="40" Height="30" Stretch="Uniform" VerticalAlignment="Center"/>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="HEAVYPRO BETA" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="Intro" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                <StackPanel x:Name="Body"/>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="© 2026 Rotaidem. All rights reserved." Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeclineButton" Content="Decline" Width="100" Margin="0,0,8,0" Click="Decline_Click"/>
                <Button x:Name="AcceptButton" Content="I agree" Width="110" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Accept_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
