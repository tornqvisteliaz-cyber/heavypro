<Window x:Class="HeavyFeel.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to HeavyPro"
        Width="460" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg0}"
        Foreground="{StaticResource BrushText}"
        UseLayoutRounding="True">
    <Border Style="{StaticResource Card}" Margin="18" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="{StaticResource RotaidemLogo}" Width="88" Height="64"
                       Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="HEAVYPRO" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="BY ROTAIDEM" Style="{StaticResource SectionText}"
                           Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Center" Margin="0,4,0,10"/>
                <TextBlock Text="Connect to MSFS and shape your aircraft’s control response."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="330"/>
            </StackPanel>
            <Button Grid.Row="1" Content="Let’s fly" Width="110" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click"/>
        </Grid>
    </Border>
</Window>
