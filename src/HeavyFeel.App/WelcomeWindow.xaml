<Window x:Class="HeavyFeel.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RSG"
        Width="340"
        Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BrushBg1}"
        Foreground="{StaticResource BrushText}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="welcome to RSG"
                   FontSize="20"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        <Button Grid.Row="1"
                Content="OK"
                Width="72"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="Ok_Click"/>
    </Grid>
</Window>
