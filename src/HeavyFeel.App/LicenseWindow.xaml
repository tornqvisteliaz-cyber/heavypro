<Window x:Class="HeavyFeel.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate HeavyPro"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBg0}"
        Foreground="{StaticResource BrushText}"
        FontFamily="Segoe UI" FontSize="13">
    <Border Style="{StaticResource Card}" Margin="14" Padding="20">
        <StackPanel>
            <TextBlock Text="ACTIVATE HEAVYPRO" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
            <TextBlock Text="Enter the licence key from your purchase email. It looks like HPRO-XXXX-XXXX-XXXX."
                       TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,14"/>
            <TextBox x:Name="KeyBox" FontFamily="Consolas" FontSize="16" Padding="8,6"
                     CharacterCasing="Upper" Background="{StaticResource BrushBg2}"
                     Foreground="{StaticResource BrushText}" BorderBrush="{StaticResource BrushLine}"
                     CaretBrush="{StaticResource BrushText}"/>
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,10,0,0"
                       Foreground="{StaticResource BrushBad}" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Quit" Click="Quit_Click" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="ActivateButton" Content="Activate" Style="{StaticResource PrimaryButton}"
                        Click="Activate_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
