<Window x:Class="HeavyFeel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeavyPro"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        Background="{StaticResource BrushBg0}"
        Foreground="{StaticResource BrushText}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBg1}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock>
                        <Run Text="HeavyPro" FontWeight="SemiBold"/>
                        <Run Text="  —  " Foreground="{StaticResource BrushMuted}"/>
                        <Run Text="{Binding AircraftTitle, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding AircraftMeta}" Style="{StaticResource MutedText}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Normal" Command="{Binding SetFeelNormalCommand}" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FeelTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeelNormal}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Medium" Command="{Binding SetFeelMediumCommand}" Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FeelTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeelMedium}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Realistic" Command="{Binding SetFeelRealisticCommand}" Margin="0,0,12,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FeelTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeelRealistic}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BrushBg3}"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding ConnectionLabel}" VerticalAlignment="Center" Margin="0,0,12,0" FontFamily="Consolas"/>
                    <CheckBox Content="Master" IsChecked="{Binding MasterEnable}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,4,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBg1}" BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DataRate}" Style="{StaticResource MutedText}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Aircraft">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/>
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedText}" Text="{Binding DetectedProfile, StringFormat=Detected: {0}}"/>
                            <CheckBox Content="Auto-connect" IsChecked="{Binding AutoConnect}"/>
                            <CheckBox Content="Log telemetry" IsChecked="{Binding LogTelemetry}"/>
                            <CheckBox Content="Show debug" IsChecked="{Binding DebugMode}"/>
                            <CheckBox Content="Use with FSRealistic / ChasePlane" IsChecked="{Binding CompanionMode}"/>
                            <CheckBox Content="View cue (cockpit)" IsChecked="{Binding ViewCue}"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Companion on: FSR keeps sound and camera. HeavyPro only shapes the stick."/>
                            <TextBlock Text="{Binding WriteStatus}" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Feel">
                        <StackPanel>
                            <TextBlock Text="{Binding FeelCaption}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Inertia"/>
                                <TextBlock Text="{Binding Inertia, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding Inertia}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Pitch"/>
                                <TextBlock Text="{Binding PitchDamping, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding PitchDamping}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Roll"/>
                                <TextBlock Text="{Binding RollDamping, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding RollDamping}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Yaw"/>
                                <TextBlock Text="{Binding YawDamping, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding YawDamping}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Response"/>
                                <TextBlock Text="{Binding ControlResponse, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding ControlResponse}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Ground"/>
                                <TextBlock Text="{Binding GroundInertia, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding GroundInertia}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Turbulence"/>
                                <TextBlock Text="{Binding TurbulenceResponse, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Value="{Binding TurbulenceResponse}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Debug">
                        <TextBlock Text="{Binding DebugPanel}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Telemetry" Margin="0">
                    <ScrollViewer>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource MutedText}" Text="IAS"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Ias}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource MutedText}" Text="TAS"/>
                            <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Tas}"/>

                            <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Text="Mach"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Mach}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource MutedText}" Text="GS"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Gs}"/>

                            <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Text="VS"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Vs}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource MutedText}" Text="Alt"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Alt}"/>

                            <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Text="Pitch"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Pitch}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource MutedText}" Text="Bank"/>
                            <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Bank}"/>

                            <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" Text="HDG"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Hdg}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource MutedText}" Text="Pos"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding LatLon}"/>

                            <TextBlock Grid.Row="5" Style="{StaticResource MutedText}" Text="AoA"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding AoA}"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource MutedText}" Text="Beta"/>
                            <TextBlock Grid.Row="5" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Beta}"/>

                            <TextBlock Grid.Row="6" Style="{StaticResource MutedText}" Text="G"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding GLoad}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource MutedText}" Text="Q"/>
                            <TextBlock Grid.Row="6" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding QBar}"/>

                            <TextBlock Grid.Row="7" Style="{StaticResource MutedText}" Text="State"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueText}" Text="{Binding OnGround}"/>

                            <TextBlock Grid.Row="8" Style="{StaticResource MutedText}" Text="AP"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Ap}"/>
                            <TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource MutedText}" Text="Weight"/>
                            <TextBlock Grid.Row="8" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Weight}"/>

                            <TextBlock Grid.Row="9" Style="{StaticResource MutedText}" Text="Fuel"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Fuel}"/>
                            <TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource MutedText}" Text="MOI"/>
                            <TextBlock Grid.Row="9" Grid.Column="3" Style="{StaticResource ValueText}" Text="{Binding Moi}"/>

                            <TextBlock Grid.Row="10" Style="{StaticResource MutedText}" Text="Config"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueText}" Text="{Binding Config}"/>

                            <TextBlock Grid.Row="11" Style="{StaticResource MutedText}" Text="Thrust"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueText}" Text="{Binding Thrust}"/>

                            <TextBlock Grid.Row="12" Style="{StaticResource MutedText}" Text="Stick"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueText}" Text="{Binding Controls}"/>

                            <TextBlock Grid.Row="13" Style="{StaticResource MutedText}" Text="Surfaces"/>
                            <TextBlock Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueText}" Text="{Binding Surfaces}"/>

                            <TextBlock Grid.Row="14" Style="{StaticResource MutedText}" Text="Rot"/>
                            <TextBlock Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource ValueText}" Text="{Binding RotX, StringFormat={}{0}   }"/>
                        </Grid>
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="Log" Margin="0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                        <ListBox ItemsSource="{Binding LogLines}"
                                 Background="{StaticResource BrushBg0}"
                                 Foreground="{StaticResource BrushMuted}"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="11"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
