<Window x:Class="HeavyFeel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeavyPro | RSG Software"
        Width="1320" Height="850"
        MinWidth="980" MinHeight="700"
        Background="{StaticResource BrushBg0}"
        Foreground="{StaticResource BrushText}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="{StaticResource BrushBg1}"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/HeavyPro;component/Assets/RsgLogo.png" Width="112" Height="43"
                       Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Grid.Column="1" Width="1" Height="34" Background="{StaticResource BrushLine}" Margin="18,0"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HeavyPro" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="  /  FLIGHT FEEL" Foreground="{StaticResource BrushAccent}"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="4,3,0,0"/>
                    </StackPanel>
                    <TextBlock Text="RSG SOFTWARE  ·  MSFS CONTROL RESPONSE" Style="{StaticResource SectionText}" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushBg2}" BorderBrush="{StaticResource BrushLine}"
                            BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConnectionLabel}" Value="CONNECTED">
                                                <Setter Property="Fill" Value="{StaticResource BrushGood}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionLabel}" Value="LIVE">
                                                <Setter Property="Fill" Value="{StaticResource BrushGood}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ConnectionLabel}" Value="ERROR">
                                                <Setter Property="Fill" Value="{StaticResource BrushBad}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionLabel}" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource BrushAccentDim}" BorderBrush="{StaticResource BrushLine}"
                            BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,0">
                        <CheckBox Content="MASTER ENABLE" IsChecked="{Binding MasterEnable}" Margin="0"
                                  FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,6,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource BrushBg1}"
                BorderBrush="{StaticResource BrushLine}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding BackendName}" Style="{StaticResource SectionText}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Margin="18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="FEEL PROFILE" Style="{StaticResource SectionText}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Normal" Command="{Binding SetFeelNormalCommand}" Margin="0,0,4,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FeelTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFeelNormal}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushBg0}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1" Content="Medium" Command="{Binding SetFeelMediumCommand}" Margin="2,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FeelTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFeelMedium}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushBg0}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="2" Content="Realistic" Command="{Binding SetFeelRealisticCommand}" Margin="4,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource FeelTab}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFeelRealistic}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushBg0}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding FeelCaption}" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                                       FontSize="11" Margin="0,10,0,2"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RESPONSE TUNING" Style="{StaticResource SectionText}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Inertia"/><TextBlock Text="{Binding Inertia, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding Inertia}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Pitch"/><TextBlock Text="{Binding PitchDamping, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding PitchDamping}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Roll"/><TextBlock Text="{Binding RollDamping, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding RollDamping}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Yaw"/><TextBlock Text="{Binding YawDamping, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding YawDamping}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Response"/><TextBlock Text="{Binding ControlResponse, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding ControlResponse}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Ground"/><TextBlock Text="{Binding GroundInertia, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding GroundInertia}" Margin="0,0,0,7"/>
                            <Grid Margin="0,0,0,2"><TextBlock Text="Turbulence"/><TextBlock Text="{Binding TurbulenceResponse, StringFormat={}{0:0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                            <Slider Value="{Binding TurbulenceResponse}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="AIRCRAFT &amp; APP" Style="{StaticResource SectionText}" Margin="0,0,0,9"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"/>
                            <TextBlock Text="{Binding DetectedProfile, StringFormat=Detected: {0}}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,5"/>
                            <CheckBox Content="Auto-connect" IsChecked="{Binding AutoConnect}"/>
                            <CheckBox Content="Log telemetry" IsChecked="{Binding LogTelemetry}"/>
                            <CheckBox Content="Show debug data" IsChecked="{Binding DebugMode}"/>
                            <CheckBox Content="Cockpit view cue" IsChecked="{Binding ViewCue}"/>
                            <TextBlock Text="{Binding WriteStatus}" TextWrapping="Wrap" FontFamily="Consolas"
                                       FontSize="10" Foreground="{StaticResource BrushAccent}" Margin="0,11,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SYSTEM NOTES" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                            <TextBlock Text="HeavyPro shapes control response. It does not replace the aircraft flight model. Some add-on aircraft may ignore SimConnect control events."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11"/>
                            <TextBlock Text="{Binding DebugPanel}" TextWrapping="Wrap" FontFamily="Consolas"
                                       FontSize="10" Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DebugMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12" ClipToBounds="True">
                    <Grid>
                        <Image Source="/HeavyPro;component/Assets/RsgBanner.png" Opacity="0.075"
                               Stretch="UniformToFill" HorizontalAlignment="Right" Width="350"
                               IsHitTestVisible="False"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ACTIVE AIRCRAFT" Style="{StaticResource SectionText}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding AircraftTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding AircraftMeta}" Style="{StaticResource MutedText}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" Margin="1,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0">
                                <TextBlock Text="{Binding DetectedProfile}" Foreground="{StaticResource BrushAccent}"
                                           FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DataRate}" Style="{StaticResource MutedText}" FontFamily="Consolas"
                                           FontSize="10" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel><TextBlock Text="AIRSPEED" Style="{StaticResource SectionText}"/><TextBlock Text="{Binding Ias}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel><TextBlock Text="ALTITUDE" Style="{StaticResource SectionText}"/><TextBlock Text="{Binding Alt}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel><TextBlock Text="VERTICAL SPEED" Style="{StaticResource SectionText}"/><TextBlock Text="{Binding Vs}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel><TextBlock Text="G LOAD" Style="{StaticResource SectionText}"/><TextBlock Text="{Binding GLoad}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="LIVE FLIGHT DATA" Style="{StaticResource SectionText}"/>
                            <TextBlock Text="{Binding OnGround}" Style="{StaticResource MutedText}" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="78"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="TAS" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Tas}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="MACH" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Mach}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="GROUND SPD" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gs}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="HEADING" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Hdg}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="PITCH" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Pitch}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="BANK" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Bank}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Text="ANGLE OF ATTACK" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AoA}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="SIDESLIP" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding Beta}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Text="AUTOPILOT" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Ap}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="DYNAMIC PRESSURE" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding QBar}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Text="WEIGHT" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Weight}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="FUEL" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="5" Grid.Column="3" Text="{Binding Fuel}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="6" Text="MOMENT OF INERTIA" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Moi}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="CONFIG" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding Config}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="7" Text="THRUST" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Thrust}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="7" Grid.Column="2" Text="CONTROLS" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="7" Grid.Column="3" Text="{Binding Controls}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="8" Text="SURFACES" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Surfaces}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="8" Grid.Column="2" Text="POSITION" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding LatLon}" Style="{StaticResource ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="9" Text="ROTATION X" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding RotX}" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}"
                                Padding="10,4" Margin="10,0,0,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="EVENT LOG" Style="{StaticResource SectionText}" Margin="0,0,0,6"/>
                            <ListBox ItemsSource="{Binding LogLines}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
